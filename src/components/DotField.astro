---
// Campo de puntos animado de fondo (canvas), compartido por las secciones que lo usan (hero y contacto).
// Va como primer hijo de una <section> con position: relative y overflow: hidden; el contenido de la sección debe
// tener position: relative para quedar por encima. Puntos que flotan despacio, se unen con líneas finas entre sí y con
// el cursor, y se apartan un poco de él. Con movimiento reducido se dibuja una sola vez, quieto.
---

<canvas class="field" data-field aria-hidden="true"></canvas>

<script>
  document.querySelectorAll<HTMLCanvasElement>("[data-field]").forEach((canvas) => {
    const hero = canvas.parentElement as HTMLElement;
    const ctx = canvas.getContext("2d");
    if (!hero || !ctx) return;
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    type P = { x: number; y: number; vx: number; vy: number; r: number; hue: number };
    let w = 0, h = 0, dpr = 1, pts: P[] = [], ink = "#0b1f33", accent = "#0b6e8e";
    let mx = -9999, my = -9999, visible = true;

    const readColors = () => {
      const cs = getComputedStyle(hero);
      ink = cs.getPropertyValue("--hero-ink").trim() || ink;
      accent = cs.getPropertyValue("--accent").trim() || accent;
    };
    const resize = () => {
      const r = hero.getBoundingClientRect();
      dpr = Math.min(window.devicePixelRatio || 1, 2);
      w = r.width; h = r.height;
      canvas.width = Math.round(w * dpr); canvas.height = Math.round(h * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      const n = Math.min(120, Math.round((w * h) / 9500));
      pts = Array.from({ length: n }, () => ({
        x: Math.random() * w, y: Math.random() * h,
        vx: (Math.random() - 0.5) * 0.18, vy: (Math.random() - 0.5) * 0.18,
        r: 0.8 + Math.random() * 1.6, hue: Math.random() < 0.18 ? 1 : 0, // algunos puntos van en el color de acento
      }));
    };

    const LINK = 105, REACH = 160, PUSH = 90;
    const frame = () => {
      ctx.clearRect(0, 0, w, h);
      for (const p of pts) {
        if (!reduce) {
          p.x += p.vx; p.y += p.vy;
          if (p.x < -10) p.x = w + 10; else if (p.x > w + 10) p.x = -10;
          if (p.y < -10) p.y = h + 10; else if (p.y > h + 10) p.y = -10;
          const dx = p.x - mx, dy = p.y - my, d = Math.hypot(dx, dy);
          if (d < PUSH && d > 0.1) { const f = (1 - d / PUSH) * 0.9; p.x += (dx / d) * f; p.y += (dy / d) * f; }
        }
      }
      ctx.lineWidth = 1;
      for (let i = 0; i < pts.length; i++) {
        const a = pts[i];
        for (let j = i + 1; j < pts.length; j++) {
          const b = pts[j], d = Math.hypot(a.x - b.x, a.y - b.y);
          if (d < LINK) { ctx.globalAlpha = (1 - d / LINK) * 0.16; ctx.strokeStyle = ink; ctx.beginPath(); ctx.moveTo(a.x, a.y); ctx.lineTo(b.x, b.y); ctx.stroke(); }
        }
        const dm = Math.hypot(a.x - mx, a.y - my);
        if (dm < REACH) { ctx.globalAlpha = (1 - dm / REACH) * 0.55; ctx.strokeStyle = accent; ctx.beginPath(); ctx.moveTo(a.x, a.y); ctx.lineTo(mx, my); ctx.stroke(); }
      }
      for (const p of pts) {
        const near = Math.hypot(p.x - mx, p.y - my) < REACH;
        ctx.globalAlpha = near ? 0.9 : p.hue ? 0.55 : 0.28;
        ctx.fillStyle = near || p.hue ? accent : ink;
        ctx.beginPath(); ctx.arc(p.x, p.y, near ? p.r + 0.6 : p.r, 0, Math.PI * 2); ctx.fill();
      }
      ctx.globalAlpha = 1;
    };

    readColors(); resize(); frame();
    new MutationObserver(() => { readColors(); if (reduce) frame(); }).observe(document.documentElement, { attributes: true, attributeFilter: ["data-theme"] });
    window.addEventListener("resize", () => { resize(); if (reduce) frame(); });

    if (!reduce) {
      hero.addEventListener("pointermove", (e) => {
        if (e.pointerType !== "mouse") return;
        const r = hero.getBoundingClientRect();
        mx = e.clientX - r.left; my = e.clientY - r.top;
      });
      hero.addEventListener("pointerleave", () => { mx = my = -9999; });
      new IntersectionObserver(([e]) => (visible = e.isIntersecting)).observe(hero);
      const loop = () => {
        if (visible) frame();
        requestAnimationFrame(loop);
      };
      requestAnimationFrame(loop);
    }
  });
</script>

<style>
  .field {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }
</style>
