---
import { ui, type Locale } from "../i18n/ui";

interface Props {
  locale: Locale;
}

const t = ui[Astro.props.locale].steps;
---

<section id="como-trabajamos" class="steps" aria-labelledby="pasos-titulo">
  <div class="container">
    <header class="head" data-reveal>
      <p class="eyebrow">{t.eyebrow}</p>
      <h2 id="pasos-titulo">{t.title}</h2>
    </header>
    <ol class="list" data-timeline>
      {
        t.items.map(([n, title, desc], i) => (
          <li data-reveal style={`--delay:${i * 0.12}s`}>
            <span class="n" aria-hidden="true">{n}</span>
            <h3>{title}</h3>
            <p>{desc}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<script>
  // Línea de tiempo que avanza con el scroll: la línea se llena (--p, de 0 a 1) y cada paso se enciende (.on) cuando
  // la línea lo alcanza; en móvil, cuando el paso llega al 70 % de la pantalla. Sin animaciones, todo queda encendido.
  const list = document.querySelector<HTMLElement>("[data-timeline]");
  if (list && document.documentElement.classList.contains("reveal")) {
    const steps = [...list.querySelectorAll<HTMLElement>("li")];
    const mobile = window.matchMedia("(max-width: 900px)");
    let queued = false;
    const update = () => {
      queued = false;
      const r = list.getBoundingClientRect(), vh = window.innerHeight;
      const p = Math.max(0, Math.min(1, (vh * 0.85 - r.top) / (vh * 0.45)));
      list.style.setProperty("--p", String(p));
      steps.forEach((li) => {
        const on = mobile.matches ? li.getBoundingClientRect().top < vh * 0.7 : p * r.width >= li.offsetLeft;
        li.classList.toggle("on", on);
      });
    };
    const queue = () => {
      if (!queued) {
        queued = true;
        requestAnimationFrame(update);
      }
    };
    list.classList.add("live");
    window.addEventListener("scroll", queue, { passive: true });
    window.addEventListener("resize", queue);
    update();
  }
</script>

<style>
  .steps {
    background: var(--card);
    padding-block: 96px;
  }
  .head {
    display: grid;
    gap: 12px;
    max-width: 900px;
    margin-bottom: 48px;
  }
  .eyebrow {
    color: var(--eyebrow-l);
  }
  h2 {
    font-size: clamp(2rem, 3.6vw, 2.75rem);
    line-height: 1.1;
  }
  /* Línea de tiempo: una línea con un nodo por paso. */
  .list {
    position: relative;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 32px;
    margin: 0;
    padding: 48px 0 0;
    list-style: none;
  }
  .list::before,
  .list::after {
    content: "";
    position: absolute;
    top: 9px;
    left: 0;
    right: 0;
    height: 2px;
    background: var(--line);
  }
  /* Tramo recorrido de la línea: completo sin JavaScript; con el script, crece con --p. */
  .list::after {
    right: auto;
    width: calc(var(--p, 1) * 100%);
    background: var(--eyebrow-l);
  }
  li {
    position: relative;
    display: grid;
    align-content: start;
    gap: 10px;
  }
  li::before {
    content: "";
    position: absolute;
    top: -48px;
    left: 0;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: var(--eyebrow-l);
    transition: background 0.3s, transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  .live li:not(.on)::before {
    background: var(--line);
    transform: scale(0.7);
  }
  .n {
    color: var(--eyebrow-l);
    font-weight: 500;
    font-size: 0.875rem;
    letter-spacing: 0.12em;
  }
  h3 {
    font-size: 1.75rem;
  }
  p {
    color: var(--page-muted);
  }

  @media (max-width: 900px) {
    .steps {
      padding-block: 56px;
    }
    .head {
      margin-bottom: 28px;
    }
    .list {
      grid-template-columns: 1fr;
      gap: 24px;
      padding: 0;
    }
    .list::before,
    .list::after,
    li::before {
      display: none;
    }
    li {
      padding-left: 19px;
      border-left: 3px solid var(--eyebrow-l);
      transition: border-color 0.4s;
    }
    .live li:not(.on) {
      border-left-color: var(--line);
    }
    h3 {
      font-size: 1.5rem;
    }
  }
</style>
