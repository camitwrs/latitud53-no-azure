---
// Logo de Latitud53 (Austral, opción punto): isotipo + "Latitud53" con el "53" en el color de acento.
// Proporción del diseño: isotipo 104, texto 64, separación 22 % del isotipo.
import { logoSvg } from "../lib/globe";

interface Props {
  size?: number; // alto del isotipo en px
  label?: string; // nombre accesible; si el logo va dentro de un enlace con texto, se omite
}

const { size = 32, label } = Astro.props;
---

<span class="logo" style={`--size:${size}px`} role={label ? "img" : undefined} aria-label={label}>
  <span class="mark" set:html={logoSvg({ small: size <= 48 })} />
  <span class="word" aria-hidden={label ? "true" : undefined}>Latitud<span class="num">53</span></span>
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: calc(var(--size) * 0.22);
    color: var(--logo-fg);
  }
  .mark {
    width: var(--size);
    height: var(--size);
    flex: none;
  }
  .mark :global(svg) {
    width: 100%;
    height: 100%;
  }
  .word {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: calc(var(--size) * 0.75);
    letter-spacing: var(--tracking-display);
    line-height: 1;
  }
  .num {
    color: var(--logo-num);
  }
</style>
